# OpenAI (required for /api/hr and /api/agent)
OPENAI_API_KEY=sk-...
# Back-compat single model (used if the splits below are unset)
OPENAI_MODEL=gpt-4o
# Prefer splitting cost vs quality:
# OPENAI_ROUTER_MODEL=gpt-4o-mini
# OPENAI_AGENT_MODEL=gpt-4o

# Optional alternate chat models (picker in /app). Auto uses first available.
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...
# XAI_API_KEY=xai-...

# StackOne — unified HCM MCP (Workday, ADP, Dayforce). See /app/plugins
# STACKONE_API_KEY=...

# Auth (required for login)
NEXTAUTH_SECRET=your-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=Alph@123
# Admin bypass: this email gets full access without Stripe/trial (defaults to AUTH_EMAIL if unset)
# ADMIN_EMAIL=admin@example.com

# Optional: in development, set to "1" to append logs to ./logs/hr-api.log
# LOG_TO_FILE=1

# Optional: on Vercel, suppress Node deprecation warning from dependencies (url.parse)
# NODE_OPTIONS=--disable-warning=DEP0169

# Landing page + free trial (magic link)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_...
RESEND_FROM=trial@yourdomain.com
# Optional if different from NEXTAUTH_URL (used as base for magic link URL)
# SITE_URL=https://seeknimbly.ai

# Stripe (15-day free trial; cancel anytime via Billing portal)
STRIPE_SECRET_KEY=sk_...
STRIPE_PRICE_ID=price_...
# Annual price (churn-survival lever — unlocks second checkout button)
STRIPE_PRICE_ID_ANNUAL=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cron (Vercel Cron Authorization: Bearer …)
# CRON_SECRET=long-random-string
